# Example environment variables for data ingestion
# Copy this to .env and fill in your credentials

# Sentinel Hub (optional, for faster access)
SENTINEL_USERNAME=your_username
SENTINEL_PASSWORD=your_password

# Landsat USGS EarthExplorer
LANDSAT_USERNAME=your_username
LANDSAT_PASSWORD=your_password

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=land-detection-satellite-data

# Phase 2 - Commercial Providers (for paid clients)
PLANET_API_KEY=your_planet_api_key
MAXAR_API_KEY=your_maxar_api_key

# Application Settings
LOG_LEVEL=INFO
DATA_DIR=data
