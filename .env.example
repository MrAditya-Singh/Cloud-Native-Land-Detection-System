# Environment variables for the Land Detection System

# Application
DEBUG=False
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# S3 Buckets
S3_SATELLITE_DATA_BUCKET=land-detection-satellite-data
S3_ML_MODELS_BUCKET=land-detection-ml-models
S3_RESULTS_BUCKET=land-detection-results

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/land_detection

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
SECRET_KEY=change-this-to-a-secure-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ML Configuration
MODEL_CONFIDENCE_THRESHOLD=0.75
BATCH_SIZE=32

# SageMaker
SAGEMAKER_ENDPOINT_NAME=land-detection-endpoint

# Monitoring
ENABLE_METRICS=True
